<header>
    <div class="logo">
        <a href="/" style="text-decoration:none;">
            <h2 style="color:var(--accent);"><i class="fas fa-code"></i> DevStyle</h2>
        </a>
    </div>

    <form class="search-bar" action="/" method="GET">
        <input type="text" name="search" placeholder="Buscar productos...">
        <button type="submit"><i class="fas fa-search"></i></button>
    </form>

    <nav class="user-nav">
        <div class="user-actions">

            <% if (locals.isLogged) { %>
                <a href="/users/profile" style="color: var(--accent); margin-right: 15px; font-weight: bold; text-decoration: none;" class="profile-greeting">
                    ¡Hola, <%= locals.userLogged.name %>! 👋
                </a>
                <a href="/users/logout" class="btn-login" style="background-color: #ff4757;"><i
                        class="fas fa-sign-out-alt"></i> Salir</a>

                <% } else { %>
                    <a href="/users/register" class="btn-register"><i class="fas fa-user-plus"></i> Registro</a>
                    <a href="/users/login" class="btn-login"><i class="fas fa-sign-in-alt"></i> Login</a>
                    <% } %>

                        <a href="/products/cart" class="btn-cart" style="position: relative; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="fas fa-shopping-cart"></i>
                            <span id="cart-badge" style="position: absolute; top: -10px; right: -10px; background-color: var(--accent); color: white; border-radius: 50%; width: 15px; height: 15px; font-size: 0.65rem; font-weight: bold; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.5);">0</span>
                        </a>
        </div>
    </nav>
</header>