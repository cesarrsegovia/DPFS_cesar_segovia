<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>

    <%- include('../partials/header') %>

    <main class="cart-container">
        <h1>Tu Carrito de Compras</h1>

        <div class="cart-layout">
            
            <div class="cart-items-wrapper" style="flex: 2; display: flex; flex-direction: column; gap: 20px;">
                 <section class="cart-items" id="cart-items-list" style="margin-bottom: 0; width: 100%;">
                    
                    <article class="cart-item">
                        <div class="item-img">
                            <img src="/img/teclado.jpg" alt="Teclado Mecánico">
                        </div>
                        <div class="item-info">
                            <h3>Teclado Mecánico RGB</h3>
                            <p class="unit-price">Precio: $120.00</p>
                        </div>
                        <div class="item-quantity">
                            <label>Cant:</label>
                            <input type="number" value="1" min="1">
                        </div>
                        <div class="item-subtotal">
                            <p>$120.00</p>
                        </div>
                        <button class="btn-remove"><i class="fas fa-trash-alt"></i></button>
                    </article>
    
                    <article class="cart-item">
                        <div class="item-img">
                            <img src="/img/mouse.jpg" alt="Mouse Gamer">
                        </div>
                        <div class="item-info">
                            <h3>Mouse Ergonómico</h3>
                            <p class="unit-price">Precio: $55.00</p>
                        </div>
                        <div class="item-quantity">
                            <label>Cant:</label>
                            <input type="number" value="2" min="1">
                        </div>
                        <div class="item-subtotal">
                            <p>$110.00</p>
                        </div>
                        <button class="btn-remove"><i class="fas fa-trash-alt"></i></button>
                    </article>
    
                </section>
                
                <div style="text-align: left;">
                    <a href="/" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none; padding: 12px 25px; border-radius: 5px; font-weight: bold; color: white; background-color: #2c2c2c; border: 1px solid #4f5b66; transition: background-color 0.2s;">
                        <i class="fas fa-arrow-left"></i> SEGUIR COMPRANDO
                    </a>
                </div>
            </div>

            <section class="cart-summary">
                <h2>Resumen del pedido</h2>
                <div class="summary-row">
                    <span id="cart-summary-subtotal-label">Subtotal (3 ítems)</span>
                    <span id="cart-summary-subtotal">$230.00</span>
                </div>
                <div class="summary-row">
                    <span>Envío</span>
                    <span style="color:var(--accent);">Gratis</span>
                </div>
                <div class="summary-row">
                    <span>Impuestos</span>
                    <span id="cart-summary-tax">$21.00</span>
                </div>
                <hr>
                <div class="summary-row total">
                    <span>Total</span>
                    <span id="cart-summary-total">$251.00</span>
                </div>

                <button class="btn-checkout">FINALIZAR COMPRA</button>
                
                <div class="secure-checkout">
                    <i class="fas fa-lock"></i> Pago 100% Seguro
                </div>
            </section>
        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>