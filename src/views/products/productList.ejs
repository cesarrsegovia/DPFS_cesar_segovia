<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head') %>
</head>

<body>

    <%- include('../partials/header') %>

        <main>
            <section class="products-section" style="min-height: 70vh; padding: 40px 5%;">
                <h2 style="margin-bottom: 30px; border-left: 5px solid var(--accent); padding-left: 10px;">Todos los Productos</h2>

                <% if (products.length === 0) { %>
                    <div class="no-results" style="text-align: center; padding: 60px 20px; width: 100%; background: var(--bg-card); border-radius: 10px; border: 1px dashed #444;">
                        <i class="fas fa-search" style="font-size: 3.5rem; color: var(--accent); margin-bottom: 20px; display: block;"></i>
                        <h3 style="color: white; margin-bottom: 10px; font-size: 1.5rem;">No hay productos cargados</h3>
                        <p style="color: var(--text-gray); margin-bottom: 25px; font-size: 1.05rem;">Actualmente no hay productos registrados en el catálogo.</p>
                        <a href="/" class="btn-primary" style="display: inline-block; width: auto; padding: 12px 30px; font-size: 0.95rem; text-decoration: none;">Volver al Home</a>
                    </div>
                <% } else { %>
                    <div class="product-grid">
                        <% products.forEach(product=> { %>
                            <article class="product-card">
                                <a href="/products/detail/<%= product.id %>">
                                    <img src="/img/<%= product.image %>" alt="<%= product.name %>">
                                    <div class="product-info">
                                        <h3>
                                            <%= product.name %>
                                        </h3>
                                        <p class="price">$<%= product.price %>
                                        </p>
                                        <% if (product.discount > 0) { %>
                                            <p style="font-size: 0.8rem; color: #4caf50;">
                                                <%= product.discount %>% OFF
                                            </p>
                                        <% } %>
                                    </div>
                                </a>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </main>

        <%- include('../partials/footer') %>

</body>

</html>
