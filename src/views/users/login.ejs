<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head') %>
</head>

<body>

    <%- include('../partials/header') %>

        <main class="auth-container">
            <section class="auth-box">
                <h2>¡Hola de nuevo! 👋</h2>

                <form action="/users/login" method="POST" class="auth-form" novalidate>

                    <div class="form-group">
                        <label for="email">Correo Electrónico</label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope"></i>
                            <input type="email" id="email" name="email" /* Persistencia (Old Data) */
                                value="<%= locals.oldData ? oldData.email : null %>">
                        </div>
                        <div id="error-email" style="color: red; font-size: 0.8rem; margin-top: 5px;"></div>
                        <% if (locals.errors && errors.email) { %>
                            <div class="text-danger" style="color: red; font-size: 0.8rem; margin-top: 5px;">
                                <%= errors.email.msg %>
                            </div>
                            <% } %>
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="password" name="password">
                        </div>
                        <div id="error-password" style="color: red; font-size: 0.8rem; margin-top: 5px;"></div>
                        <% if (locals.errors && errors.password) { %>
                            <div class="text-danger" style="color: red; font-size: 0.8rem; margin-top: 5px;">
                                <%= errors.password.msg %>
                            </div>
                            <% } %>
                    </div>

                    <div class="remember-me">
                        <input type="checkbox" name="remember_user" id="remember">
                        <label for="remember">Recordarme</label>
                    </div>

                    <button type="submit" class="btn-primary">INGRESAR</button>
                </form>

                <div class="auth-footer">
                    <p>¿Aún no tienes cuenta? <a href="/users/register">Regístrate gratis</a></p>
                </div>
            </section>
        </main>

        <script src="/js/loginValidation.js"></script>
        <%- include('../partials/footer') %>

</body>

</html>